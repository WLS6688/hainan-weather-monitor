# 企业微信群机器人 webhook（必填；不填则脚本自动 dry-run，只打印卡片 JSON）
WECHAT_WEBHOOK=

# 卡片按钮/跳转项指向的台风路径图地址（可选，默认官方 nmc 网页）
TYPHOON_PATH_URL=https://typhoon.nmc.cn/web.html

# 自定义要抓图的产品页（可选；默认概率预报图 probability-img1.html）
# 想要交互地图截图时改用：TYPHOON_SHOT_URL=https://typhoon.nmc.cn/web.html
# TYPHOON_SHOT_URL=https://www.nmc.cn/publish/typhoon/probability-img1.html

# 仅当使用 --screenshot（截交互地图）时才需要：图床仓库与 token
# CDN_REPO=WLS6688/hainan-weather-monitor
# GITHUB_TOKEN=

# 海南判定阈值（可选，默认 550 km）：台风路径点距海南中心不超过该值即视为“影响海南”。
# 想更宽松（更早预警）就调大，想更严格就调小。
# HAINAN_MAX_KM=550
